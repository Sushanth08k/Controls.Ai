# ==============================================================================
# Agentic Control Automation Platform - Environment Configuration Example
# Copy this file to .env and configure your keys
# ==============================================================================

# Application & API Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Security & RBAC Defaults
DEFAULT_USER_EMAIL=sushanth@controls.ai
DEFAULT_USER_ROLE=COMPLIANCE_ANALYST
JWT_SECRET=change-this-in-production-super-secure-token-32chars

# Google Gemini API Configuration (Used for Dynamic SQL Generation)
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Alternative variable name:
# GOOGLE_API_KEY=

# Local Simulated SQLite Databases (Active by default)
SQLITE_DB_PATH=sim/compliance_sim.db
SQLITE_ARCHIVE_PATH=sim/bank_archive.db
SQLITE_CORE_PATH=sim/bank_core.db

# LiteLLM / LLM Gateway Settings
LITELLM_MOCK=1
LITELLM_FALLBACK_MOCK=1
LITELLM_API_BASE=http://localhost:4000
LITELLM_TELEMETRY=False

# Multi-Cluster PostgreSQL Connections (Docker Compose / Production)
DATABASE_URL_CORE=postgresql://postgres:postgrespassword@localhost:5432/core_banking_sim
DATABASE_URL_ARCHIVE=postgresql://postgres:postgrespassword@localhost:5433/archive
DATABASE_URL_META=postgresql://postgres:postgrespassword@localhost:5434/control_meta
DATABASE_URL_VULN=postgresql://postgres:postgrespassword@localhost:5435/vuln_target

# Temporal Workflow Engine
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=controls-automation-queue

# OpenBao / HashiCorp Vault Secrets Management
BAO_ADDR=http://localhost:8200
BAO_TOKEN=root

# Open Policy Agent (OPA)
OPA_URL=http://localhost:8181

# Evidence Object Store (SeaweedFS / S3 Compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=any
S3_SECRET_ACCESS_KEY=any
S3_BUCKET_EVIDENCE=audit-evidence
S3_REGION=us-east-1
