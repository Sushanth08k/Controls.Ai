# ==============================================================================
# Controls.Ai - Environment Configuration Example
# ==============================================================================

# Application & API Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# LLM Provider Selection: "ollama" (Local / Remote Qwen 2.5) or "gemini"
LLM_PROVIDER=ollama

# Ollama / Qwen 2.5 Coder Configuration
# If Ollama is running on another machine/host, change localhost to that machine's IP (e.g. http://192.168.1.50:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder
OLLAMA_TIMEOUT=30.0

# Google Gemini API Configuration (Used as fallback or primary when LLM_PROVIDER=gemini)
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Policy Document Storage (Cloudinary)
# Stores original uploaded policy PDF/DOCX/TXT files
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend Configuration (Vite & Firebase Authentication)
VITE_API_URL=
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
